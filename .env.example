# ---- Server ----
PORT=5050
NODE_ENV=development

# ---- Supabase (Postgres + storage) ----
# Leave BLANK to run with the in-memory demo store (data resets on restart).
# Set these to persist to a real Supabase project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Clerk auth ----
# Leave BLANK in dev to use the built-in dev-admin bypass (no login required).
# Set in production; server refuses to start in prod without CLERK_SECRET_KEY.
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Secret key for the shared "Comley Nexus" Clerk instance (Phase C pilot,
# lib/dualAuth.js). A fallback only — if a request has no valid session from
# this app's OWN instance above, we also check whether it's carrying a valid
# session from the shared one before giving up. Existing users on this app's
# own instance are completely unaffected either way.
SHARED_CLERK_SECRET_KEY=

# View-as impersonation handoff (lib/viewAsToken.js, lib/viewAsHandoff.js) --
# verifies the short-lived token Nexus Command mints at
# POST /api/impersonate/field/:orgId. Must be the EXACT SAME value as
# Command's own VIEW_AS_HANDOFF_SECRET and CMS's -- generate once with
# `openssl rand -hex 32` and copy it to all three envs. Deliberately a
# separate secret from SHARED_CLERK_SECRET_KEY above (see
# lib/viewAsToken.js's header for why).
VIEW_AS_HANDOFF_SECRET=

# Comma-separated emails that bootstrap as manager_admin on first login.
ADMIN_EMAILS=ecomley45@gmail.com

# Comma-separated emails allowed into the Nexus Super Admin console
# (/super-admin) — the platform-operator tier, distinct from a client
# workspace's own Manager Admin. Falls back to ADMIN_EMAILS if unset.
PLATFORM_ADMIN_EMAILS=ecomley45@gmail.com

# ---- Automated backups (optional) ----
# Set a long random value; the daily Vercel Cron sends it as a Bearer token to
# /api/cron/backup, which writes a full JSON snapshot to a private Storage bucket.
# Leave blank to disable the endpoint.
CRON_SECRET=

# ---- Online payments (optional, Stripe) ----
# Set the secret key to enable "Pay online" on invoices and the customer portal.
# Set the webhook signing secret and point a Stripe webhook at
# /api/stripe/webhook (event: checkout.session.completed) so paid invoices are
# marked automatically. Both leave the feature off when blank.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- SMS notifications (optional, Twilio) ----
# Set all three to enable "on the way" texts to customers. Leave blank to disable.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---- AI assistant (optional) ----
# Leave BLANK to hide the "Ask Dispatch AI" feature entirely. Set an Anthropic
# API key to enable the streaming drafting assistant. Server-only — never sent
# to the browser. Optionally override the model (defaults to claude-opus-5).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ---- Error monitoring (optional, Sentry) ----
# Two separate DSNs from two Sentry projects: one for the Node API, one for the
# React app. Both leave monitoring OFF when blank, so the app runs fine without
# them. SENTRY_DSN is server-only; VITE_SENTRY_DSN is baked into the browser
# bundle at build time (safe — a DSN is a public write-only key).
SENTRY_DSN=
VITE_SENTRY_DSN=
# The client only reports in production builds by default. Set this to 1 to test
# Sentry from a local `npm run dev` without shipping.
# VITE_SENTRY_FORCE=1
# For readable (un-minified) client stack traces, upload source maps at build
# time. Create an internal integration / auth token in Sentry with project:write.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
